<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Talia Desktop reads a vault's QR code with the camera (decided 2026-11-15).
     The hardened runtime blocks the camera unless the app is signed with this. -->
<plist version="1.0">
    <dict>
        <key>com.apple.security.device.camera</key>
        <true/>
    </dict>
</plist>
